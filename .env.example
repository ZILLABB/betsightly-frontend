# BetSightly Frontend — Environment Variables
# Copy this file to .env and fill in your values

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000/api

# API request timeout in milliseconds (default: 30s)
VITE_API_TIMEOUT=30000

# Optional API key sent as X-API-Key header (leave blank if backend doesn't require it)
VITE_API_KEY=

# Cache duration in milliseconds (default: 1 hour)
VITE_CACHE_DURATION=3600000

# Football API key (only required if using external football data API)
VITE_FOOTBALL_API_KEY=
