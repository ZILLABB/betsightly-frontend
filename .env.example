# BetSightly Frontend — Environment Variables
# Copy this file to .env and fill in your values

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000/api

# API request timeout in milliseconds (default: 30s)
VITE_API_TIMEOUT=30000

# Cache duration in milliseconds (default: 1 hour)
VITE_CACHE_DURATION=3600000

# PostHog browser capture (the project token is intentionally public).
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_UI_HOST=https://us.posthog.com

# Temporary dual-validation window; remove the legacy rewrite and browser
# fallback after live PostHog/admin counts have matched for 7–14 days.
VITE_ANALYTICS_DUAL_WRITE_UNTIL=2026-09-17T23:59:59Z
